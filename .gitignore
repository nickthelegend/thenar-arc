# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example is the one that ships
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deployer key — never commit
.env.deployer
.env.deployer.json
.env.local

# local trajectory store
.data/

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/
contracts/lib/
contracts/node_modules/

# the local Arc fork's state, keys and deployment (scripts/arc-fork.mjs)
.fork/

# agent harness dirs
.claude/
.codex/
.cursor/
.grok/
.agents/


# The object detector's runtime, copied from @mediapipe/tasks-vision on install.
/public/vision/wasm/
/.next-*/
contracts/broadcast/
