# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — the example is the one that ships
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deployer key — never commit
.env.deployer
.env.deployer.json
.env.local

# local trajectory store
.data/

# foundry
contracts/out/
contracts/cache/
contracts/broadcast/
contracts/lib/

# agent harness dirs
.claude/
.codex/
.cursor/
.grok/
.agents/

# generated CAD exports (regenerate with python3 cad/arm.py)
cad/exports/
