# Secrets never leave this machine. The verifier key lives on the backend only.
.env.deployer
.env.local
.env*.local

# Not part of the frontend deployment.
#
# Anchored with a leading slash, all three of them. Unanchored, `contracts/`
# matches a directory of that name at any depth — which silently excluded
# `app/contracts/`, the page that lists every deployed contract. The build
# succeeded, the route simply was not there, and the page 404'd on the alias
# while working on the origin that deploys from git.
/contracts/
/cad/
/scripts/
*.db
*.db-wal
*.db-shm
