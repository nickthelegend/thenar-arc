{
  "name": "thenar-arc",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/changelog.mjs && next dev",
    "build": "node scripts/changelog.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --import ./test/register.mjs --test test/score.test.mjs test/phases.test.mjs test/merkle.test.mjs test/similarity.test.mjs test/failure.test.mjs test/split.test.mjs test/rollout.test.mjs test/progression.test.mjs test/shortfall.test.mjs test/engines.test.mjs test/store-failure.test.mjs test/scan-logs.test.mjs test/scan.test.mjs test/teach.test.mjs test/so101.test.mjs test/embodiment.test.mjs test/arm-relay.test.mjs test/physicality.test.mjs test/webauthn.test.mjs test/leader-protocol.test.mjs test/llm-double.test.mjs test/receipt-timers.test.mjs test/corpus-preview.test.mjs test/agent-decision.test.mjs test/signer-health.test.mjs test/auth-config.test.mjs test/race.test.mjs",
    "arm-relay": "node scripts/arm-relay.mjs",
    "demo": "node scripts/demo.mjs",
    "test:e2e": "node test/e2e.mjs",
    "postinstall": "mkdir -p public/vision/wasm && cp node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.* public/vision/wasm/",
    "test:agent": "NEXT_PUBLIC_ARC_NETWORK=fork node --import ./test/register.mjs test/live-agent.mjs",
    "typecheck": "tsc --noEmit",
    "contracts:build": "cd contracts && forge build",
    "contracts:test": "cd contracts && forge test",
    "contracts:test:fork": "cd contracts && ARC_FORK_TESTS=1 ${ARC_FORGE:-arc-forge} test --network arc --match-path 'test/fork/*'",
    "abi": "cd contracts && forge build && cd .. && node scripts/gen-abi.mjs",
    "deploy:testnet": "bash scripts/deploy.sh testnet && node scripts/apply-deploy.mjs",
    "deploy:mainnet": "bash scripts/deploy.sh mainnet && node scripts/apply-deploy.mjs",
    "fork": "node scripts/arc-fork.mjs",
    "fork:stop": "node scripts/arc-fork.mjs stop",
    "fork:app": "node scripts/fork-app.mjs",
    "test:fork": "NEXT_PUBLIC_ARC_NETWORK=fork BASE=http://localhost:9010 node --import ./test/register.mjs test/live-fork.mjs",
    "test:e2e:fork": "NEXT_PUBLIC_ARC_NETWORK=fork BASE=http://localhost:9010 node --import ./test/register.mjs test/e2e.mjs",
    "keeper": "node --import ./test/register.mjs scripts/keeper.mjs",
    "e2e:core": "NEXT_PUBLIC_ARC_NETWORK=fork node --import ./test/register.mjs scripts/e2e-core.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@noble/curves": "^2.4.0",
    "@privy-io/node": "^0.34.0",
    "@privy-io/react-auth": "^3.42.0",
    "@privy-io/wagmi": "^4.0.17",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.101.4",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/next": "2.25.0",
    "better-sqlite3": "^13.0.3",
    "gsap": "^3.15.0",
    "motion": "^13.1.1",
    "mujoco": "^3.1.16",
    "next": "16.3.2",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "viem": "^2.55.19",
    "wagmi": "^2.16.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright": "^1.62.1",
    "serialport": "^13.0.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "ws": "^8.21.3"
  },
  "packageManager": "pnpm@10.29.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "description": "Thenar on Arc: robot training data recorded by people, paid per run in USDC, bought by AI agents over x402."
}
