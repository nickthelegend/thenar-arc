# Copy to .env.local. Values marked 0x... are secrets; never commit them.
#
# The app loads with none of this set: it browses, previews and practices with an
# empty wallet. Everything below turns on a piece of the paid path.
#
# Contract addresses are not here. They are in deployments/arc-<network>.json,
# written by scripts/apply-deploy.mjs from forge's broadcast record, and committed.
# Any of them can be overridden with its NEXT_PUBLIC_* name.

# ------------------------------------------------------------------ network
# Unset: Arc Testnet (5042002). Set to `mainnet` for Arc Mainnet (5042), or `fork`
# for a local anvil fork (pnpm fork writes .env.fork with throwaway keys).
# NEXT_PUBLIC_ARC_NETWORK=mainnet
# NEXT_PUBLIC_ARC_RPC=https://rpc.testnet.arc.io

# ------------------------------------------------------------------- signers
# The account that signs verified scores. The protocol pays only a score this key
# signed, so it must match the verifier ThenarProtocol was deployed with. Belongs
# in the signer service; /api/health fails if it drifts into the web one.
VERIFIER_PRIVATE_KEY=0x...
VERIFIER_ADDRESS=0x...
# The verifier's ERC-8004 agent id, once registered (scripts/register-agent.mjs).
# VERIFIER_AGENT_ID=

# The corpus issuer: admits verified humans to CorpusShares, issues their shares and
# writes every corpus sale to SalesLog. Needs a little USDC for gas (Arc gas is USDC).
CORPUS_ISSUER_PRIVATE_KEY=0x...
CORPUS_ISSUER_ADDRESS=0x...

# Optional: pays the gas on keeper transactions, the corpus auditor, the x402 facilitator.
# RELAYER_PRIVATE_KEY=0x...
# AUDITOR_PRIVATE_KEY=0x...
# X402_FACILITATOR_PRIVATE_KEY=0x...

# Where agents' x402 USDC goes. Unset: the deployer that funded the tasks.
# CORPUS_TREASURY=0x...

# The agent that buys the corpus over x402 (scripts/agent-buy.mjs). Needs USDC.
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...
# AGENT_ID=

# Split deployments: the web service calls this origin for signing and holds no key.
# SIGNER_ORIGIN=https://signer.example.com

# -------------------------------------------------------------------- Privy
# Operators sign in through Privy (email makes an embedded wallet on Arc). Without an
# app id the site still builds and serves public pages and browser practice; sign-in
# shows as unavailable; Arc testnet also offers an opt-in browser-held dev wallet. The client id is public; the secret is used only by the server.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Written by scripts/privy-lab.mjs: a lab's budget in a Privy server wallet whose
# policy only lets it escrow bounties in ThenarProtocol.
# PRIVY_LAB_POLICY_ID=
# PRIVY_LAB_WALLET_ID=
# PRIVY_LAB_WALLET_ADDRESS=0x...

# ------------------------------------------------------------------- store
# Unset: SQLite at ./.data/axon.db. Set: Postgres.
# DATABASE_URL=postgres://...
# Use an isolated schema when reusing an existing database on Vercel.
# DATABASE_SCHEMA=arc_thenar_testnet
# AXON_DB_PATH=/data/axon.db

# ---------------------------------------------------- optional Arc extras (off)
# Fund a task from Circle Gateway (a unified USDC balance from other chains).
# Off by default; the core loop never touches it.
# NEXT_PUBLIC_FEATURE_GATEWAY=1
# CIRCLE_GATEWAY_API_URL=https://gateway-api-testnet.circle.com

# Alternative durable store for small demos; isolated Arc DB, 12 MiB corpus cap.
# MONGODB_URI=mongodb+srv://...
# MONGODB_DB=arc_thenar_testnet
