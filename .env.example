# The account that signs verified scores. The contract will only pay a score
# this key signed, so it must match the verifier the contract was deployed with.
VERIFIER_PRIVATE_KEY=0x...

# Deployed AxonProtocol on Monad Testnet.
NEXT_PUBLIC_AXON_ADDRESS=0x82aE3011CE1dE3fce4fCf0F1A683b5d3826BCE9F

# Optional: where the trajectory store lives. Defaults to ./.data/axon.db
# AXON_DB_PATH=/data/axon.db
