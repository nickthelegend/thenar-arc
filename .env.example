# Copy to .env.local. Nothing in here is a secret; every value marked 0x... is.

# ---------------------------------------------------------------- Arc testnet
# The account that signs verified scores. The contract pays only a score this
# key signed, so it must match the verifier AxonProtocolV2 was deployed with.
VERIFIER_PRIVATE_KEY=0x...
VERIFIER_ADDRESS=0xC7D11f79514129f63427535dCB6Fdf39300F893D

# The deployment on Arc Testnet (chain 5042002). Gas, bounties and payouts are USDC.
NEXT_PUBLIC_AXON_ADDRESS=0x6D6D6D0ee86C654b69646223049D6812c0218B2f
NEXT_PUBLIC_PASSKEY_REGISTRY=0xecbbC9d43eF7C4E4Df00BC02757b8FC3E3b7615e
NEXT_PUBLIC_TRAJECTORY_CERTIFICATE=0x9dAc88a501F908FFaF41F4e0c6071c1F8B6B9B7B
NEXT_PUBLIC_CORPUS_ACCESS=0x14588B2b26c3af1D0dDabc386fCe659d662B7Bc8

# ------------------------------------------------- agents: World and Hedera
# The agent's wallet. It signs AgentKit challenges for World Chain, and it is
# also the key of HEDERA_AGENT_ID, so it signs the HBAR transfer x402 settles.
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...

# Written by scripts/hedera-setup.mjs. The treasury is what /api/agent/corpus
# asks agents to pay; the route refuses to run without it rather than open up.
HEDERA_AGENT_ID=0.0...
HEDERA_TREASURY_ID=0.0...
HEDERA_TREASURY_KEY=0x...

# ------------------------------------------------------------------- store
# Unset: SQLite at ./.data/axon.db. Set: Postgres.
# DATABASE_URL=postgres://...
# AXON_DB_PATH=/data/axon.db
