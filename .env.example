# Copy to .env.local. Nothing in here is a secret; every value marked 0x... is.
#
# Contract addresses are not here. They are in lib/deployment.ts, written by
# scripts/apply-deploy.mjs from forge's broadcast record, and committed. Any of
# them can be overridden with its NEXT_PUBLIC_* name, e.g. NEXT_PUBLIC_AXON_ADDRESS.

# --------------------------------------------------------- Monad testnet
# The account that signs verified scores. The contract pays only a score this
# key signed, so it must match the verifier AxonProtocolV2 was deployed with.
# Belongs in the signer service; /api/health fails if it drifts into the web one.
VERIFIER_PRIVATE_KEY=0x...
VERIFIER_ADDRESS=0x...

# The corpus issuer: admits World ID-verified humans to CorpusShares, issues
# their shares, and writes every corpus sale to SalesLog. Needs a little MON
# for gas. A different authority from the verifier, so a different key.
CORPUS_ISSUER_PRIVATE_KEY=0x...
CORPUS_ISSUER_ADDRESS=0x...

# Where agents' x402 USDC goes. Unset: the deployer that funded the tasks.
# CORPUS_TREASURY=0x...

# Monadscan's index, through Etherscan's multichain V2 API: an address's calls
# to the protocol, reverted ones included. Free key at etherscan.io/apis.
ETHERSCAN_API_KEY=...

# ------------------------------------------------- agents: World and x402
# The agent's wallet. It signs AgentKit challenges for World Chain and the
# USDC authorisation x402 settles on Monad. Needs testnet USDC, no MON.
AGENT_PRIVATE_KEY=0x...
AGENT_ADDRESS=0x...

# -------------------------------------------------------------------- Privy
# Operators sign in through Privy (email makes an embedded wallet on Monad).
# The client id is public; the secret is used only by the server.
NEXT_PUBLIC_PRIVY_APP_ID=...
PRIVY_APP_ID=...
PRIVY_APP_SECRET=...

# Set to 1 once gas sponsorship for Monad Testnet is enabled in the Privy
# dashboard: operators who signed in with email then pay no gas for their runs,
# their passkey registration or anything else they send (lib/contract-write.ts).
# Leave unset otherwise; Privy refuses a sponsored send it has not been told to pay for.
# NEXT_PUBLIC_PRIVY_GAS_SPONSORSHIP=1

# Written by scripts/privy-lab.mjs: a lab's budget in a Privy server wallet whose
# policy only lets it escrow bounties in AxonProtocolV2 on Monad, 0.1 MON at most.
PRIVY_LAB_POLICY_ID=...
PRIVY_LAB_WALLET_ID=...
PRIVY_LAB_WALLET_ADDRESS=0x...

# ----------------------------------------------------------------- World ID
# The Selfie Check that gates paid runs and the share whitelist.
NEXT_PUBLIC_WORLD_APP_ID=app_...
WORLD_RP_ID=...
WORLD_SIGNING_KEY=...

# ------------------------------------------------------------------- store
# Unset: SQLite at ./.data/axon.db. Set: Postgres.
# DATABASE_URL=postgres://...
# AXON_DB_PATH=/data/axon.db

# -------------------------------------------------------------------- Envio
# The indexer's GraphQL endpoint (indexer/: Envio Cloud, or the Hasura that
# indexer/scripts/start.sh runs). Read only by the server, for /api/indexer and
# the history on /leaderboard. The admin secret only if that Hasura needs one.
# ENVIO_GRAPHQL_URL=http://localhost:8089/v1/graphql
# ENVIO_GRAPHQL_SECRET=

# -------------------------------------------------------------- Chainlink CRE
# CorpusAudit, the receiver the cre/corpus-audit workflow writes its verdicts to
# (contracts/script/DeployCorpusAudit.s.sol). Once set, /api/task/{id}/manifest
# reports what the DON last found. Server-side; leave unset until it is deployed.
# CORPUS_AUDIT=0x...
